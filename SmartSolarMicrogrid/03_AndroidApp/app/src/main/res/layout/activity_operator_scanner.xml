<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify &amp; Finalize Energy Transfer"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Scan prosumer's QR code or enter reservation token manually"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColorHint="@color/text_gray"
        app:boxBackgroundColor="@color/card_dark"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQrTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="QR Code Token or Reservation #"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/text_gray"
        app:boxBackgroundColor="@color/card_dark"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOperatorNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Physical Verification Notes"
            android:text="Inverter synchronized. Grid transfer complete."
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnVerifyFinalize"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary"
        android:text="Verify &amp; Finalize Transfer"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <Button
        android:id="@+id/btnLaunchCameraScan"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="📷 Open Camera Scanner"
        android:textColor="@color/accent"
        app:cornerRadius="12dp"
        app:strokeColor="@color/accent" />
</LinearLayout>
